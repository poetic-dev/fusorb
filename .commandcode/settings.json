{
  "permissions": {
    "allow": [
      "powershell",
      "Shell(dir:*)",
      "Shell(npm:*)",
      "Shell(type:*)",
      "Shell(curl -s https://registry.npmjs.org/-/package/@fusorb/facet-auth/dist-tags)",
      "Shell(echo.:*)",
      "Shell(curl -s https://registry.npmjs.org/-/package/@fusorb/facet-sdk/dist-tags)",
      "Shell(curl -s https://registry.npmjs.org/-/package/@fusorb/facet-components/dist-tags)",
      "Shell(curl -s https://registry.npmjs.org/-/package/@fusorb/facet-docs/dist-tags)",
      "Shell(curl -s https://registry.npmjs.org/-/package/@fusorb/facet-sandbox/dist-tags)",
      "Shell(curl -s -o NUL -w %{http_code} https://registry.npmjs.org/@arcevo/facet-auth)",
      "Shell(for:*)",
      "Shell(intel:*)",
      "Shell(do:*)",
      "Shell(*.tgz:*)",
      "Shell(findstr:*)",
      "Shell(node --version)",
      "Shell(pnpm:*)",
      "Shell(kill:*)",
      "Shell(node -e \"const pkgs=['@arcevo/facet-auth','@fusorb/intel','@fusorb/intel-graph','@fusorb/facet-sandbox','@fusorb/facet-components','@fusorb/facet-docs','@fusorb/facet-store']; (async()=>{ for(const p of pkgs){ const u='https://registry.npmjs.org/'+p.replace('/','%2F'); try{ const r=await fetch(u,{signal:AbortSignal.timeout(25000)}); if(r.ok){ const j=await r.json(); console.log(p+' => HTTP '+r.status+' latest='+(j['dist-tags']&&j['dist-tags'].latest)); } else { console.log(p+' => HTTP '+r.status); } }catch(e){ console.log(p+' => ERR '+e.message); } } console.log('NODE_DONE'); })()\")",
      "Shell(git:*)",
      "Shell(docs:*)",
      "Shell(::*)",
      "Shell(node scripts/check-legacy-names.mjs --root . --ledger ecosystem/naming-ledger.json --allow ecosystem/ecosystem.json)",
      "Shell(node scripts/gen-ecosystem-docs.mjs)",
      "Shell(node scripts/check-ecosystem.mjs)",
      "Shell(node scripts/check-legacy-names.mjs --root . --ledger ecosystem/naming-ledger.json --allow ecosystem/ecosystem.json --allow content/foundation/glossary.md)",
      "Shell(node scripts/check-content.mjs)",
      "Shell(curl -s -o NUL --max-time 40 -w arcevo_facet_auth=%{http_code}\\n https://registry.npmjs.org/@arcevo/facet-auth)",
      "Shell(curl -s -o NUL --max-time 40 -w fusorb_intel=%{http_code}\\n https://registry.npmjs.org/@fusorb/intel)",
      "Shell(curl -s -o NUL --max-time 40 -w fusorb_intel_graph=%{http_code}\\n https://registry.npmjs.org/@fusorb/intel-graph)",
      "Shell(facet:*)",
      "Shell(rmdir:*)",
      "Shell(del:*)",
      "Shell(fusorb-facet-sdk-2.0.0.tgz:*)",
      "Shell(rename:*)",
      "Shell(fusorb-facet-auth-2.0.0.tgz:*)",
      "Shell(curl -s https://raw.githubusercontent.com/fusorb/facet/main/packages/layout/CHANGELOG.md)"
    ],
    "deny": [],
    "defaultMode": "default"
  }
}